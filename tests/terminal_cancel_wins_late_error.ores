import class Subscription from '../src/rx.ores';

// Deterministic linearization oracle: cancel commits while pull_result()
// is still in-flight, then the losing upstream error arrives too late.
define class CancelThenFailSubscription extends Subscription<int> as
  pub pull_result(): Result<Option<int>, Object> {
    self.cancel();
    return Err("late upstream error");
  }
end

pub async fnc main(): void {
  val Subscription<int> sub = new CancelThenFailSubscription();
  val Result<Option<int>, Object> outcome = sub.next_result();
  stdio.println(outcome.is_ok());
  stdio.println(outcome.unwrap().is_none());
  stdio.println(sub.is_cancelled());
  stdio.println(sub.is_failed());
  stdio.println(sub.is_complete());

  // Re-reads of a cancelled subscription project CANCELLED, never ERROR.
  val Result<Option<int>, Option<Object>> terminal = sub.next_signal();
  stdio.println(terminal.is_err());
  return;
}
