import class StreamEvent from '../src/rx.ores';

pub async fnc main(): void {
  val Option<int> inner_none = None;
  val Option<Option<int>> outer_some = Some(inner_none);
  val Option<Option<int>> outer_none = None;
  val StreamEvent<Option<int>> value =
      new StreamEvent<Option<int>>("next", outer_some);
  stdio.println(value.is_next());
  stdio.println(value.value.unwrap().is_none());
  stdio.println(value.is_terminal());
  val StreamEvent<Option<int>> complete =
      new StreamEvent<Option<int>>("complete", outer_none);
  stdio.println(complete.is_complete());
  stdio.println(complete.is_terminal());
  return;
}
