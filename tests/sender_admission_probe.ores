import * as rx_channels from '../src/rx.ores';
import class FramedPipe, Subscription, StreamEvent from '../src/rx.ores';

pub async fnc main(): void {
  val Option<int> witness = None;
  val FramedPipe<int> pipe = rx_channels.framed_pipe(2, witness);
  stdio.println(pipe.is_complete());
  pipe.send_blocking(12);
  stdio.println(pipe.is_complete());
  pipe.complete_blocking();
  stdio.println(pipe.is_complete());
  val Subscription<int> sub = pipe.subscribe();
  stdio.println(sub.next().unwrap());
  val StreamEvent<int> end_event = sub.next_event();
  stdio.println(end_event.is_complete());
  return;
}
