import * as rx_channels from '../src/rx.ores';
import class Observable, Subscription from '../src/rx.ores';

pub async fnc main(): void {
  val Observable<int> source = rx_channels.from_values([1, 2, 3, 4, 5, 6]);
  val Fnc<int, int> twice = |value| -> { return value * 2; };
  val Observable<int> doubled = rx_channels.map(source, twice);
  val Fnc<int, bool> large = |value| -> { return value > 4; };
  val Observable<int> filtered = rx_channels.filter(doubled, large);
  val Observable<int> skipped = rx_channels.skip(filtered, 1);
  val Observable<int> limited = rx_channels.take(skipped, 2);
  val Subscription<int> sub = limited.subscribe();
  stdio.println(sub.next().unwrap());
  stdio.println(sub.next().unwrap());
  stdio.println(sub.next().is_none());
  val Subscription<int> empty = rx_channels.take(rx_channels.skip(rx_channels.from_values([1, 2]), 1), 0).subscribe();
  stdio.println(empty.next().is_none());
  return;
}
