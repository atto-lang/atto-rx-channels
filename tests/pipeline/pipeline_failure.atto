import * as pipeline from '../../src/worker_pipeline.atto';
pub async fnc main(): void {
  val Channel<int> jobs = Channel.new<int>(1);
  val Channel<int> results = Channel.new<int>(1);
  val Channel<bool> cleaned = Channel.new<bool>(1);
  writech jobs, 0;
  val Future<void> first = pipeline.produce(jobs, 0, 0);
  val Future<void> second = pipeline.produce(jobs, 1, 0);
  // A third producer fails while both earlier producers have blocked writes.
  val Result<int, string> failed = pipeline.producer_input(2, 0, true);
  stdio.println(failed.is_err());
  stdio.println(pipeline.shutdown(cleaned, jobs, results));
  try {
    await first;
    stdio.println("unexpected admission");
  } catch (error) {
    stdio.println("first released");
  }
  try {
    await second;
    stdio.println("unexpected admission");
  } catch (error) {
    stdio.println("second released");
  }
  stdio.println(readch jobs);
  stdio.println(jobs.is_closed());
  stdio.println(pipeline.shutdown(cleaned, jobs, results));
  cleaned.close();
  return;
}
