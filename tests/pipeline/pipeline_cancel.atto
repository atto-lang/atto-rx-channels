import * as pipeline from '../../src/worker_pipeline.atto';
pub async fnc main(): void {
  val Channel<int> jobs = Channel.new<int>(1);
  val Channel<int> results = Channel.new<int>(1);
  val Channel<bool> older_stop = Channel.new<bool>(1);
  val Channel<bool> later_stop = Channel.new<bool>(1);
  val Channel<bool> cleaned = Channel.new<bool>(1);
  writech jobs, 0;
  val Future<Option<SelectResult>> older = pipeline.offer(jobs, older_stop, 1);
  val Future<Option<SelectResult>> later = pipeline.offer(jobs, later_stop, 2);
  // Both producers are blocked; cancel the older registration before draining.
  writech older_stop, true;
  val Option<SelectResult> cancelled = await older;
  stdio.println(cancelled.unwrap().index);
  stdio.println(readch jobs);
  val Option<SelectResult> admitted = await later;
  stdio.println(admitted.unwrap().index);
  stdio.println(readch jobs);
  stdio.println((try readch jobs).is_none());
  stdio.println(pipeline.shutdown(cleaned, jobs, results));
  stdio.println(pipeline.shutdown(cleaned, jobs, results));
  stdio.println(jobs.is_closed());
  older_stop.close();
  later_stop.close();
  cleaned.close();
  return;
}
