import * as rx_channels from '../src/rx.ores';
import class Observable, Subscription from '../src/rx.ores';

pub async fnc main(): void {
  val Observable<int> source = rx_channels.from_values([1, 2, 3, 4, 5]);
  val Observable<int> skipped = rx_channels.skip(source, 2);
  val Observable<int> limited = rx_channels.take(skipped, 2);
  val Subscription<int> sub = limited.subscribe();
  stdio.println(sub.next().unwrap());
  stdio.println(sub.next().unwrap());
  stdio.println(sub.next().is_none());
  val Subscription<int> zero = rx_channels.skip(rx_channels.from_values([7]), 0).subscribe();
  stdio.println(zero.next().unwrap());
  stdio.println(zero.next().is_none());
  val Subscription<int> empty = rx_channels.skip(rx_channels.from_values([1, 2]), 10).subscribe();
  stdio.println(empty.next().is_none());
  return;
}
