import * as bounded from '../src/bounded_queue.ores';
import class BoundedQueue, QueueTicket from '../src/bounded_queue.ores';

fnc print_error(Result<bool, String> outcome): void {
  match outcome
    Ok(value) -> {
      stdio.println("unexpected-ok");
    }
    Err(error) -> {
      stdio.println(error);
    }
  end
  return;
}

pub async fnc main(): void {
  val Option<int> element_type = None;
  val BoundedQueue<int> queue = bounded.bounded_queue(2, element_type);

  val QueueTicket first_ticket = queue.new_ticket().expect("first ticket");
  val QueueTicket second_ticket = queue.new_ticket().expect("second ticket");

  stdio.println(queue.try_push(11, first_ticket).expect("push 11"));
  stdio.println(queue.push_blocking(22, second_ticket).expect("push 22"));

  val QueueTicket full_ticket = queue.new_ticket().expect("full ticket");
  print_error(queue.try_push(33, full_ticket));

  val Option<int> first = queue.try_pop().expect("first pop");
  stdio.println(first.unwrap());

  val QueueTicket cancelled_ticket =
      queue.new_ticket().expect("cancelled ticket");
  stdio.println(cancelled_ticket.cancel());
  print_error(queue.push_blocking(33, cancelled_ticket));

  val QueueTicket third_ticket = queue.new_ticket().expect("third ticket");
  stdio.println(queue.push_blocking(33, third_ticket).expect("push 33"));
  print_error(queue.try_push(44, third_ticket));
  stdio.println(third_ticket.cancel());

  stdio.println(queue.try_pop().expect("second pop").unwrap());
  stdio.println(queue.try_pop().expect("third pop").unwrap());

  val QueueTicket stale_ticket = queue.new_ticket().expect("stale ticket");
  stdio.println(queue.close());
  stdio.println(queue.close());
  print_error(queue.try_push(44, stale_ticket));

  val Option<int> drained = queue.pop_blocking();
  stdio.println(drained.is_none());

  val Result<QueueTicket, String> after_close = queue.new_ticket();
  match after_close
    Ok(ticket) -> {
      stdio.println("unexpected-ticket");
    }
    Err(error) -> {
      stdio.println(error);
    }
  end
  return;
}
