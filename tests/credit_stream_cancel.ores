import * as credit from '../src/credit_stream.ores';
import class CreditPipe from '../src/credit_stream.ores';

pub async fnc main(): void {
  val Option<int> value_type = None;
  val Option<String> error_type = None;
  val CreditPipe<int, String> pipe = credit.credit_pipe(0, value_type, error_type);
  stdio.println(pipe.subscribe());
  stdio.println(pipe.request());
  stdio.println(pipe.cancel());
  val Result<Option<int>, Option<String>> signal = pipe.next_signal();
  match signal
    Err(None) -> { stdio.println(true); }
    Err(Some(error)) -> { stdio.println(false); }
    Ok(Some(value)) -> { stdio.println(false); }
    Ok(None) -> { stdio.println(false); }
  end
  stdio.println(pipe.is_cancelled());
  stdio.println(pipe.cancel());
  return;
}
