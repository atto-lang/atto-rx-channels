// Standalone golden test for the current bounded sender API and rendezvous Future.
import * as rx_channels from '../src/rx.ores';
import class FramedPipe, Subscription, StreamEvent from '../src/rx.ores';

pub async fnc main(): void {
  val Channel<Option<int>> input = Channel.new<Option<int>>(0);
  val Future<void> sending = rx_channels.send(input, 42);
  val Subscription<int> reader = rx_channels.from_channel(input).subscribe();
  val StreamEvent<int> value = reader.next_event();
  await sending;
  stdio.println(value.is_next() && value.value.unwrap() == 42);
  val Future<void> finishing = rx_channels.complete(input);
  val StreamEvent<int> done_event = reader.next_event();
  await finishing;
  stdio.println(done_event.is_complete() && reader.is_complete() && !reader.is_cancelled());

  val Option<int> typed_none = None;
  val FramedPipe<int> pipe = rx_channels.framed_pipe(1, typed_none);
  val Subscription<int> sub = pipe.subscribe();
  pipe.send_blocking(7);
  stdio.println(sub.next().unwrap() == 7);
  pipe.complete_blocking();
  stdio.println(sub.next_event().is_complete());
  val FramedPipe<int> other = rx_channels.framed_pipe(1, typed_none);
  val Subscription<int> cancelled = other.subscribe();
  val bool first = cancelled.cancel();
  val bool second = cancelled.cancel();
  stdio.println(first && !second && cancelled.is_cancelled());
  return;
}
