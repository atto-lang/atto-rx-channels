import * as rx_channels from '../src/rx.ores';
import class Observable, Subscription from '../src/rx.ores';

define class BrokenSignalSubscription extends Subscription<int> as
  pub pull_result(): Result<Option<int>, Object> {
    return Err("boom");
  }
end

fnc print_int_signal(Result<Option<int>, Option<Object>> signal): void {
  match signal
    Ok(Some(value)) -> { stdio.println(value); }
    Ok(None) -> { stdio.println("complete"); }
    Err(None) -> { stdio.println("cancelled"); }
    Err(Some(error)) -> { stdio.println("error"); }
  end
  return;
}

pub async fnc main(): void {
  val Observable<int> values = rx_channels.from_values([7]);
  val Subscription<int> sub = values.subscribe();
  print_int_signal(sub.next_signal());
  print_int_signal(sub.next_signal());

  val Subscription<int> cancelled = rx_channels.from_values([9]).subscribe();
  cancelled.cancel();
  print_int_signal(cancelled.next_signal());

  val Subscription<int> broken = new BrokenSignalSubscription();
  print_int_signal(broken.next_signal());

  val Option<int> nested_none = None;
  val Observable<Option<int>> nested_source =
      rx_channels.from_values([nested_none]);
  val Result<Option<Option<int>>, Option<Object>> nested =
      nested_source.subscribe().next_signal();
  match nested
    Ok(Some(value)) -> { stdio.println(value.is_none()); }
    Ok(None) -> { stdio.println(false); }
    Err(None) -> { stdio.println(false); }
    Err(Some(error)) -> { stdio.println(false); }
  end

  val Result<int, String> err_data = Err("ordinary-data");
  val Observable<Result<int, String>> result_source =
      rx_channels.from_values([err_data]);
  val Result<Option<Result<int, String>>, Option<Object>> result_signal =
      result_source.subscribe().next_signal();
  match result_signal
    Ok(Some(value)) -> { stdio.println(value.is_err()); }
    Ok(None) -> { stdio.println(false); }
    Err(None) -> { stdio.println(false); }
    Err(Some(error)) -> { stdio.println(false); }
  end
  return;
}
