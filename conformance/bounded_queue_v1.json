{
  "schema": "oreslang.bounded_queue.v1",
  "semantics": {
    "transport": "canonical bounded Channel<T> waiter/admission coordinator",
    "ticket": "one-shot generation-bound local cancellation capability",
    "push_linearization": [
      "ticket cancellation may win only before write commit",
      "channel close terminally settles an uncommitted write",
      "write commit permanently admits the value"
    ],
    "receive": "committed FIFO values drain before closed+empty terminal state",
    "close": "idempotent actual-channel close; no consumable synthetic close token",
    "fairness": "inherits canonical channel registration order; no second waiter queue",
    "reference_wrapper": "source-readable contract only; final multi-producer handle must be runtime/compiler-known"
  },
  "scenarios": [
    {
      "id": "full_is_non_retaining",
      "capacity": 2,
      "actions": [
        "ticket:t1",
        "try_push:1:t1",
        "ticket:t2",
        "try_push:2:t2",
        "ticket:t3",
        "try_push:3:t3"
      ],
      "outcomes": [
        "ticket:1",
        "ok",
        "ticket:2",
        "ok",
        "ticket:3",
        "full"
      ]
    },
    {
      "id": "cancel_before_ready_write",
      "capacity": 2,
      "actions": [
        "ticket:t1",
        "cancel:t1",
        "push_blocking:7:t1"
      ],
      "outcomes": [
        "ticket:1",
        "true",
        "cancelled"
      ]
    },
    {
      "id": "ticket_is_one_shot",
      "capacity": 2,
      "actions": [
        "ticket:t1",
        "try_push:1:t1",
        "try_push:2:t1",
        "cancel:t1"
      ],
      "outcomes": [
        "ticket:1",
        "ok",
        "ticket-used",
        "false"
      ]
    },
    {
      "id": "close_invalidates_unclaimed_ticket_and_drains",
      "capacity": 2,
      "actions": [
        "ticket:t1",
        "try_push:1:t1",
        "ticket:stale",
        "close",
        "try_push:2:stale",
        "pop_blocking",
        "pop_blocking"
      ],
      "outcomes": [
        "ticket:1",
        "ok",
        "ticket:2",
        "true",
        "stale-ticket",
        "some:1",
        "none"
      ]
    },
    {
      "id": "live_pending_writers_fifo",
      "capacity": 1,
      "actions": [
        "fill:0",
        "pending_push:1:t1",
        "pending_push:2:t2",
        "pop",
        "await:t1",
        "pop",
        "await:t2",
        "pop"
      ],
      "outcomes": [
        "ok",
        "pending",
        "pending",
        "value:0",
        "ok",
        "value:1",
        "ok",
        "value:2"
      ],
      "required_runtime_test": true
    },
    {
      "id": "older_cancelled_waiter_does_not_block_later_waiter",
      "capacity": 1,
      "actions": [
        "fill:0",
        "ticket:t1",
        "pending_push:1:t1",
        "ticket:t2",
        "pending_push:2:t2",
        "cancel:t1",
        "pop",
        "await:t1",
        "await:t2",
        "pop"
      ],
      "outcomes": [
        "ok",
        "ticket:1",
        "pending",
        "ticket:2",
        "pending",
        "true",
        "value:0",
        "cancelled",
        "ok",
        "value:2"
      ],
      "required_runtime_test": true
    },
    {
      "id": "close_settles_pending_and_drains_committed",
      "capacity": 1,
      "actions": [
        "fill:0",
        "pending_push:1:t1",
        "close",
        "await:t1",
        "pop",
        "pop"
      ],
      "outcomes": [
        "ok",
        "pending",
        "true",
        "closed",
        "value:0",
        "none"
      ],
      "required_runtime_test": true
    }
  ],
  "backends": [
    "java",
    "llvm",
    "net",
    "wasm",
    "forge"
  ],
  "evidence_rule": "Each backend executes independently; source lowering, runtime substrate, and guest execution are separate gates; zero-step CI is NOT_EXECUTED."
}
