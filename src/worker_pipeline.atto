// Cooperative same-domain pipeline. The coordinator grants one turn to each
// producer/worker and settles both writes before granting another turn.
// No Channel, Future or callback crosses an actor/async argument boundary.
pub fnc producer_input(int producer, int round, bool fail): Result<int, string> {
  if fail; then
    return Err("producer failed");
  fi
  return Ok(round * 2 + producer + 1);
}

pub fnc produce(Channel<int> jobs, int producer, int round): Future<void> {
  val Result<int, string> input = producer_input(producer, round, false);
  return nb writech jobs, input.expect("producer input");
}

pub fnc work(int value, Channel<int> results): Future<void> {
  return nb writech results, value * value;
}

// Cancellation participates in the same atomic arbitration as write admission.
// Losing write arms belong to the runtime coordinator, not a second waiter list.
pub fnc offer(Channel<int> jobs, Channel<bool> stopped, int value): Future<Option<SelectResult>> {
  val SelectSet cases = SelectSet.new([
    SelectCase.read(stopped), SelectCase.write(jobs, value)
  ]);
  return nb select first from cases;
}

// The coordinator is the only owner of this one-slot cleanup claim.
pub fnc shutdown(Channel<bool> claimed, Channel<int> jobs, Channel<int> results): bool {
  if !(try writech claimed, true); then
    return false;
  fi
  jobs.close();
  results.close();
  return true;
}

pub async fnc run_pipeline(int rounds, bool trace): int {
  val Channel<int> jobs = Channel.new<int>(1);
  val Channel<int> results = Channel.new<int>(1);
  val Channel<bool> cleaned = Channel.new<bool>(1);
  let int total = 0;
  try {
    for let round = 0; round < rounds; round++ {
      // The second producer is blocked while the one-slot job queue is full.
      val Future<void> producer_a = produce(jobs, 0, round);
      val Future<void> producer_b = produce(jobs, 1, round);
      val Future<void> worker_a = work(readch jobs, results);
      val Future<void> worker_b = work(readch jobs, results);
      await producer_a;
      await producer_b;
      // Deliberately slow collector: both workers submit before either read.
      // At most one buffered result and one pending result write exist.
      val int first = readch results;
      val int second = readch results;
      await worker_a;
      await worker_b;
      if trace; then
        stdio.println(first);
        stdio.println(second);
      fi
      total = total + first + second;
    }
  } finally {
    shutdown(cleaned, jobs, results);
    cleaned.close();
  }
  return total;
}
