// Typed bounded queue policy built on Oreslang Channel<T>.
//
// Channel<T> remains the only buffer, waiter registry and select coordinator.
// This wrapper adds one-shot cancellation tickets plus a queue generation.
// Closing the queue closes the *actual item channel*. That is essential:
// Channel.close() linearizes with pending writes under the runtime coordinator,
// rejects all uncommitted writers and preserves committed buffered values for
// FIFO drain. No consumable "closed token" is used.

fnc queue_marker_set(Channel<bool> marker): bool {
  val Option<bool> present = try readch marker;
  if present.is_some(); then
    try writech marker, true;
    return true;
  fi
  return false;
}

define class QueueTicket as
  val int queue_generation;
  val int sequence;
  val Channel<bool> cancelled = Channel.new<bool>(1);
  val Channel<bool> claimed = Channel.new<bool>(1);
  val Channel<bool> settled = Channel.new<bool>(1);
  val Channel<bool> state_gate = Channel.new<bool>(1);

  constructor(int queue_generation, int sequence) {
    self.queue_generation = queue_generation;
    self.sequence = sequence;
    writech self.state_gate, true;
  }

  pub generation(): int {
    return self.queue_generation;
  }

  pub id(): int {
    return self.sequence;
  }

  // Cancellation is idempotent. The state gate makes observation/update of
  // the marker state one ticket-local critical section.
  pub cancel(): bool {
    val bool permit = readch self.state_gate;
    try {
      if queue_marker_set(self.settled); then
        return false;
      fi
      return try writech self.cancelled, true;
    } finally {
      writech self.state_gate, permit;
    }
  }

  pub is_cancelled(): bool {
    val bool permit = readch self.state_gate;
    try {
      return queue_marker_set(self.cancelled);
    } finally {
      writech self.state_gate, permit;
    }
  }

  // Internal protocol surface used by BoundedQueue<T>. A ticket is one-shot.
  pub claim_once(): bool {
    val bool permit = readch self.state_gate;
    try {
      if queue_marker_set(self.settled); then
        return false;
      fi
      return try writech self.claimed, true;
    } finally {
      writech self.state_gate, permit;
    }
  }

  // Static select needs the raw local cancellation capability. QueueTicket is
  // therefore execution-domain-local and cannot cross an actor boundary.
  pub cancellation_signal(): Channel<bool> {
    return self.cancelled;
  }

  // A selected cancellation read consumes its token. Restore it so the ticket
  // remains observably cancelled after the winning arm runs.
  pub restore_cancelled(): void {
    val bool permit = readch self.state_gate;
    try {
      try writech self.cancelled, true;
    } finally {
      writech self.state_gate, permit;
    }
    return;
  }

  pub settle_once(): bool {
    val bool permit = readch self.state_gate;
    try {
      return try writech self.settled, true;
    } finally {
      writech self.state_gate, permit;
    }
  }

  pub is_settled(): bool {
    val bool permit = readch self.state_gate;
    try {
      return queue_marker_set(self.settled);
    } finally {
      writech self.state_gate, permit;
    }
  }
end

define class BoundedQueue<T> as
  val Channel<T> items;
  val Channel<bool> state_gate = Channel.new<bool>(1);
  val int capacity;
  let int generation;
  let int next_ticket;

  constructor(int capacity) {
    if capacity < 1; then
      val Result<bool, String> invalid =
          Err("bounded queue capacity must be positive");
      invalid.expect("rx_channels.BoundedQueue");
    fi
    self.items = Channel.new<T>(capacity);
    self.capacity = capacity;
    self.generation = 1;
    self.next_ticket = 1;
    writech self.state_gate, true;
  }

  pub get_capacity(): int {
    return self.capacity;
  }

  pub get_generation(): int {
    val bool permit = readch self.state_gate;
    try {
      return self.generation;
    } finally {
      writech self.state_gate, permit;
    }
  }

  pub is_closed(): bool {
    return self.items.is_closed();
  }

  // Issue exactly one push-attempt ticket. Close increments generation before
  // closing items, so every unclaimed pre-close ticket becomes stale.
  pub new_ticket(): Result<QueueTicket, String> {
    val bool permit = readch self.state_gate;
    try {
      if self.items.is_closed(); then
        return Err("closed");
      fi
      val int sequence = self.next_ticket;
      self.next_ticket = self.next_ticket + 1;
      return Ok(new QueueTicket(self.generation, sequence));
    } finally {
      writech self.state_gate, permit;
    }
  }

  // Immediate admission. Full never leaves a pending waiter.
  pub try_push(T value, QueueTicket ticket): Result<bool, String> {
    val bool permit = readch self.state_gate;
    try {
      if ticket.generation() != self.generation; then
        ticket.settle_once();
        return Err("stale-ticket");
      fi
      if self.items.is_closed(); then
        ticket.settle_once();
        return Err("closed");
      fi
      if !ticket.claim_once(); then
        return Err("ticket-used");
      fi
      if ticket.is_cancelled(); then
        ticket.settle_once();
        return Err("cancelled");
      fi
      val bool admitted = try writech self.items, value;
      ticket.settle_once();
      if admitted; then
        return Ok(true);
      fi
      return Err("full");
    } finally {
      writech self.state_gate, permit;
    }
  }

  // Suspending admission. "_blocking" means the source continuation may
  // suspend; it never authorizes parking an actor carrier thread.
  //
  // The static select races cancellation against the write itself. Queue close
  // closes items under the same runtime channel coordinator. If close wins
  // before the write commits, the write arm completes with the channel-closed
  // failure; the catch maps that terminal channel state to Err("closed").
  //
  // If write commit wins first, the item is admitted permanently. A later
  // cancellation cannot retract it.
  pub push_blocking(T value, QueueTicket ticket): Result<bool, String> {
    val bool permit = readch self.state_gate;
    try {
      if ticket.generation() != self.generation; then
        ticket.settle_once();
        return Err("stale-ticket");
      fi
      if self.items.is_closed(); then
        ticket.settle_once();
        return Err("closed");
      fi
      if !ticket.claim_once(); then
        return Err("ticket-used");
      fi
    } finally {
      writech self.state_gate, permit;
    }

    val Channel<bool> cancellation = ticket.cancellation_signal();

    try {
      do select first {
        when readch cancellation: const ignored {
          ticket.restore_cancelled();
          ticket.settle_once();
          return Err("cancelled");
        }
        when writech self.items, value: {
          ticket.settle_once();
          return Ok(true);
        }
      }
    } catch (err) {
      ticket.settle_once();
      if self.items.is_closed(); then
        return Err("closed");
      fi
      throw err;
    }
  }

  // Immediate receive:
  //   Ok(Some(value)) => one FIFO item
  //   Ok(None)        => closed and fully drained
  //   Err("empty")    => open but no item ready now
  //
  // state_gate prevents close from being published between the empty probe and
  // the closed-state classification. Concurrent writers may still make a
  // subsequent item available after an open+empty result, which is correct for
  // a nonblocking probe.
  pub try_pop(): Result<Option<T>, String> {
    val bool permit = readch self.state_gate;
    try {
      try {
        val Option<T> item = try readch self.items;
        if item.is_some(); then
          return Ok(item);
        fi
      } catch (err) {
        if self.items.is_closed(); then
          return Ok(None);
        fi
        throw err;
      }

      if self.items.is_closed(); then
        return Ok(None);
      fi
      return Err("empty");
    } finally {
      writech self.state_gate, permit;
    }
  }

  // Channel.close() itself preserves buffered values before terminal read
  // failure, so blocking receive needs no separate close signal.
  pub pop_blocking(): Option<T> {
    try {
      val T value = readch self.items;
      return Some(value);
    } catch (err) {
      if self.items.is_closed(); then
        return None;
      fi
      throw err;
    }
  }

  // Idempotent logical close. Increment the generation before close becomes
  // observable so an unclaimed ticket from the old generation is stale.
  // Channel.close() atomically settles pending writes and preserves buffered
  // items for FIFO drain.
  pub close(): bool {
    val bool permit = readch self.state_gate;
    try {
      if self.items.is_closed(); then
        return false;
      fi
      self.generation = self.generation + 1;
      self.items.close();
      return true;
    } finally {
      writech self.state_gate, permit;
    }
  }
end

pub fnc bounded_queue<T>(
    int capacity,
    Option<T> witness
): BoundedQueue<T> {
  if witness.is_some(); then
    val Result<bool, String> invalid =
        Err("bounded queue witness must be None");
    invalid.expect("rx_channels.bounded_queue");
  fi
  return new BoundedQueue<T>(capacity);
}
