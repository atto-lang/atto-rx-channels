// Pull methods are ordinary source methods with suspending bodies. Generic
// async callables are not yet supported by the reference compiler.

// Inspect a capacity-one marker by try-read/restore. This helper IS NOT
// atomic: another caller can observe a transient empty channel between the
// read and write. It may be used only for a single-owner marker (such as
// per-pull bookkeeping) or under a separate admission mutex that guards
// *every* competing marker observation/claim. Subscription terminal markers
// use state_busy; FramedSender terminal probes use admission. NEVER use this
// alone to arbitrate cancellation, completion or cross-actor shared state.
// Both probes are immediate and install no waiter.
fnc marked(Channel<bool> marker): bool {
  val present = try readch marker;
  if present.is_some(); then
    // Put the marker back: this is a non-destructive state probe.
    try writech marker, true;
    return true;
  fi
  return false;
}

// Legacy source-level projection. This is intentionally not the full
// NEXT/COMPLETE/ERROR/CANCELLED typed event ABI. Do not use it to launder
// ordinary failures into normal completion. Constructor admission is strict:
// Some(None) is valid when T itself is an Option.
define class StreamEvent<T> as
  val String kind;
  pub val Option<T> value;
  constructor(String kind, Option<T> value) {
    if kind != "next" && kind != "complete" && kind != "cancelled"; then
      val Result<bool, String> invalid =
          Err("StreamEvent kind must be next, complete, or cancelled");
      invalid.expect("rx_channels.StreamEvent");
    fi
    if kind == "next" && value.is_none(); then
      val Result<bool, String> invalid = Err("StreamEvent next requires Some");
      invalid.expect("rx_channels.StreamEvent");
    fi
    if kind != "next" && value.is_some(); then
      val Result<bool, String> invalid =
          Err("StreamEvent terminal must not carry a value");
      invalid.expect("rx_channels.StreamEvent");
    fi
    self.kind = kind;
    self.value = value;
  }
  pub is_next(): bool { return self.kind == "next"; }
  pub is_complete(): bool { return self.kind == "complete"; }
  pub is_cancelled(): bool { return self.kind == "cancelled"; }
  pub is_terminal(): bool {
    return self.kind == "complete" || self.kind == "cancelled";
  }
end

define class Subscription<T> as
  val Channel<bool> cancelled = Channel.new<bool>(1);
  val Channel<bool> finished = Channel.new<bool>(1);
  // Failure is terminal but is never natural completion.
  val Channel<bool> failed = Channel.new<bool>(1);
  val Channel<bool> pulling = Channel.new<bool>(1);
  val Channel<bool> disposed = Channel.new<bool>(1);

  // A capacity-one write-held mutex. The token is placed on acquire and
  // removed on release; unlike marked(), admission and terminal claims are
  // observed in the same serialized critical section. Do not hold this
  // while self.pull(), self.dispose(), or any awaited user callback runs.
  val Channel<bool> state_busy = Channel.new<bool>(1);

  // Non-panicking data path for ordinary upstream failure. Panic/raise and
  // runtime cancellation remain stronger control channels and are not Err data.
  pub next_result(): Result<Option<T>, Object> {
    writech self.state_busy, true;
    try {
      if marked(self.failed); then
        return Err("subscription previously failed");
      fi
      if marked(self.cancelled) || marked(self.finished); then
        return Ok(None);
      fi
      if !(try writech self.pulling, true); then
        return Err("only one outstanding next() is allowed");
      fi
    } finally {
      try readch self.state_busy;
    }

    val Channel<bool> settled = Channel.new<bool>(1);
    try {
      val Result<Option<T>, Object> pulled = self.pull_result();
      match pulled
        Ok(frame) -> {
          if frame.is_none(); then
            self.claim_finished();
            self.dispose_once();
          fi
          try writech settled, true;
          if self.is_cancelled(); then
            return Ok(None);
          fi
          return Ok(frame);
        }
        Err(err) -> {
          // Failure is only observable if it wins the serialized terminal
          // claim. A cancellation/completion that already won must not be
          // overwritten by a later upstream error from the in-flight pull.
          val bool failed_now = self.claim_failed();
          self.dispose_once();
          try writech settled, true;
          if !failed_now; then
            return Ok(None);
          fi
          return Err(err);
        }
      end
    } catch (err) {
      val bool failed_now = self.claim_failed();
      self.dispose_once();
      try writech settled, true;
      if !failed_now; then
        return Ok(None);
      fi
      return Err(err);
    } finally {
      if !marked(settled); then
        self.claim_failed();
        self.dispose_once();
      fi
      try readch self.pulling;
    }
  }

  // Compatibility projection. Prefer next_result() whenever ordinary upstream
  // failure must remain recoverable data rather than becoming a panic.
  pub next(): Option<T> {
    val Result<Option<T>, Object> outcome = self.next_result();
    return outcome.expect("rx_channels upstream failed");
  }

  pub pull_result(): Result<Option<T>, Object> {
    try {
      return Ok(self.pull());
    } catch (err) {
      return Err(err);
    }
  }

  pub pull(): Option<T> {
    return None;
  }

  pub dispose(): void {
    return;
  }

  // Claim normal completion only if cancellation has not already won.
  // A completion racing with cancel() uses one serialized terminal order.
  claim_finished(): bool {
    writech self.state_busy, true;
    try {
      if marked(self.cancelled) || marked(self.finished) ||
          marked(self.failed); then
        return false;
      fi
      val bool claimed = try writech self.finished, true;
      return claimed;
    } finally {
      try readch self.state_busy;
    }
  }

  // Claim failure only if cancellation or natural completion has not won.
  claim_failed(): bool {
    writech self.state_busy, true;
    try {
      if marked(self.cancelled) || marked(self.finished) ||
          marked(self.failed); then
        return false;
      fi
      val bool claimed = try writech self.failed, true;
      return claimed;
    } finally {
      try readch self.state_busy;
    }
  }

  // Disposal is claimed at most once across completion/failure/cancel.
  // No state_busy held across disposal: subclasses may signal select.
  dispose_once(): void {
    if !(try writech self.disposed, true); then
      return;
    fi
    self.dispose();
    return;
  }

  pub is_cancelled(): bool {
    writech self.state_busy, true;
    try {
      return marked(self.cancelled);
    } finally {
      try readch self.state_busy;
    }
  }

  pub is_complete(): bool {
    writech self.state_busy, true;
    try {
      return marked(self.finished) && !marked(self.cancelled) &&
          !marked(self.failed);
    } finally {
      try readch self.state_busy;
    }
  }

  pub is_failed(): bool {
    writech self.state_busy, true;
    try {
      return marked(self.failed);
    } finally {
      try readch self.state_busy;
    }
  }

  // Closed typed signal using compiler-owned Option/Result ADTs:
  //   Ok(Some(value)) = NEXT(value)
  //   Ok(None)        = COMPLETE
  //   Err(None)       = CANCELLED
  //   Err(Some(error))= ERROR(error)
  //
  // Nested data remains unambiguous. If T = Option<U>, NEXT(None) is
  // Ok(Some(None)); if T = Result<A,B>, Err data is still inside Some(T).
  pub next_signal(): Result<Option<T>, Option<Object>> {
    val Result<Option<T>, Object> outcome = self.next_result();
    match outcome
      Ok(frame) -> {
        if frame.is_some(); then
          return Ok(frame);
        fi
        if self.is_cancelled(); then
          return Err(None);
        fi
        return Ok(None);
      }
      Err(err) -> {
        return Err(Some(err));
      }
    end
  }

  pub next_event_result(): Result<StreamEvent<T>, Object> {
    val Result<Option<T>, Option<Object>> signal = self.next_signal();
    match signal
      Ok(frame) -> {
        if frame.is_some(); then
          return Ok(new StreamEvent<T>("next", frame));
        fi
        return Ok(new StreamEvent<T>("complete", None));
      }
      Err(error) -> {
        if error.is_none(); then
          return Ok(new StreamEvent<T>("cancelled", None));
        fi
        return Err(error.unwrap());
      }
    end
  }

  pub next_event(): StreamEvent<T> {
    val Result<StreamEvent<T>, Object> outcome = self.next_event_result();
    return outcome.expect("rx_channels upstream failed");
  }

  pub cancel(): bool {
    writech self.state_busy, true;
    let bool claimed = false;
    try {
      if marked(self.cancelled) || marked(self.finished) ||
          marked(self.failed); then
        return false;
      fi
      claimed = try writech self.cancelled, true;
    } finally {
      try readch self.state_busy;
    }
    if claimed; then
      self.dispose_once();
    fi
    return claimed;
  }
end
define class Observable<T> as
  pub subscribe(): Subscription<T> {
    return new Subscription<T>();
  }
end

// A raw channel is hot/unicast. Never hand out competing subscriptions:
// only one consumer can receive its single terminal frame.
define class ChannelObservable<T> extends Observable<T> as
  val Channel<Option<T>> input;
  val Channel<bool> subscribed = Channel.new<bool>(1);
  constructor(Channel<Option<T>> input) { self.input = input; }
  pub subscribe(): Subscription<T> {
    if !(try writech self.subscribed, true); then
      val Result<bool, String> failure = Err("only one subscriber is allowed");
      failure.expect("rx_channels.ChannelObservable.subscribe");
    fi
    return new ChannelSubscription<T>(self.input);
  }
end

define class ValuesObservable<T> extends Observable<T> as
  val Array<T> values;
  // Array<T> is move-only on this compiler. Take its ownership rather
  // than pretending rt copy has a Symbol.rtCopy lowering already.
  constructor(Array<T> values) { self.values = values; }
  pub subscribe(): Subscription<T> { return new ValuesSubscription<T>(self.values); }
end

define class ChannelSubscription<T> extends Subscription<T> as
  val Channel<Option<T>> input;
  val Channel<bool> stopped;
  val SelectSet cases;

  constructor(Channel<Option<T>> input) {
    self.input = input;
    self.stopped = Channel.new<bool>(1);
    self.cases = SelectSet.new([SelectCase.read(self.stopped), SelectCase.read(input)]);
  }

  pub pull(): Option<T> {
    val Option<SelectResult> selected_option =
        await (nb select first from self.cases);
    if selected_option.is_none(); then
      return None;
    fi
    val SelectResult selected = selected_option.unwrap();
    val int index = selected.index;
    if index == 0; then
      return None;
    fi
    val Option<T> frame = selected.value;
    return frame;
  }

  pub dispose(): void {
    // Signal before abandoning a pending pull: select detaches its losing
    // input registration. Never close the channel owned by the producer.
    try writech self.stopped, true;
    return;
  }
end

define class ValuesSubscription<T> extends Subscription<T> as
  val Array<T> values;
  val Channel<int> cursor = Channel.new<int>(1);
  val int size;

  constructor(Array<T> values) {
    let int size = 0;
    for const value of values do
      size = size + 1;
    done
    self.values = values;
    self.size = size;
    writech self.cursor, 0;
  }

  pub pull(): Option<T> {
    val int index = readch self.cursor;
    if index >= self.size; then
      writech self.cursor, index;
      return None;
    fi
    val T value = self.values[index];
    writech self.cursor, index + 1;
    return Some(value);
  }
end

pub fnc from_channel<T>(Channel<Option<T>> input): Observable<T> {
  return new ChannelObservable<T>(input);
}

pub fnc from_values<T>(Array<T> values): Observable<T> {
  return new ValuesObservable<T>(values);
}

// Prefer this owned, checked sender when frame-protocol safety matters.
// The checked sender exposes only acknowledged, credit-bounded public
// delivery. Raw send(channel)/complete(channel) remain legacy unchecked
// channel helpers and are intentionally outside FramedSender/FramedPipe.
define class FramedSender<T> as
  val Channel<Option<T>> output;
  val Channel<bool> terminal = Channel.new<bool>(1);
  // Protect terminal probing and admission as one source-level critical turn.
  // NEVER hold this permit while awaiting the admitted Future<void>: a
  // capacity-zero channel needs its consumer to make forward progress.
  val Channel<bool> admission = Channel.new<bool>(1);
  // Strong backpressure path: one source-level delivery may be awaiting
  // settlement at a time. Legacy send()/complete() remain Future-returning
  // compatibility APIs and can bypass this credit if callers use them directly.
  val Channel<bool> delivery_credit = Channel.new<bool>(1);

  constructor(Channel<Option<T>> output) {
    self.output = output;
    writech self.admission, true;
    writech self.delivery_credit, true;
  }

  pub is_complete(): bool {
    val bool permit = readch self.admission;
    try {
      return marked(self.terminal);
    } finally {
      writech self.admission, permit;
    }
  }

  // Internal admission primitive. Public callers must use send_blocking()
  // so the sender-owned delivery credit remains held until settlement.
  send_admitted(T value): Future<void> {
    val bool permit = readch self.admission;
    try {
      if marked(self.terminal); then
        val Result<bool, String> failure = Err("send after completion");
        failure.expect("rx_channels.FramedSender.send_blocking");
      fi
      // Admission is ordered among this sender's methods. Callers must still
      // await returned Futures to bound pending writes and observe failures.
      return nb writech self.output, Some(value);
    } finally {
      writech self.admission, permit;
    }
  }

  // Internal terminal admission primitive. Public callers must use
  // complete_blocking() so terminal delivery is acknowledged before credit
  // returns to any later operation.
  complete_admitted(): Future<void> {
    val bool permit = readch self.admission;
    try {
      if !(try writech self.terminal, true); then
        val Result<bool, String> failure = Err("duplicate completion");
        failure.expect("rx_channels.FramedSender.complete_blocking");
      fi
      val Option<T> end_frame = None;
      return nb writech self.output, end_frame;
    } finally {
      writech self.admission, permit;
    }
  }

  // Preferred bounded-registration path. "_blocking" means the Ores
  // continuation suspends; it never parks a carrier thread.
  pub suspends send_blocking(T value): void {
    val bool credit = readch self.delivery_credit;
    try {
      val Future<void> delivery = self.send_admitted(value);
      await delivery;
    } finally {
      writech self.delivery_credit, credit;
    }
  }

  pub suspends complete_blocking(): void {
    val bool credit = readch self.delivery_credit;
    try {
      val Future<void> delivery = self.complete_admitted();
      await delivery;
    } finally {
      writech self.delivery_credit, credit;
    }
  }
end

// The transport and sender never escape; one producer, one subscriber.
define class FramedPipe<T> extends Observable<T> as
  val Channel<Option<T>> input;
  val FramedSender<T> writer;
  val Channel<bool> subscribed = Channel.new<bool>(1);

  constructor(int capacity) {
    self.input = Channel.new<Option<T>>(capacity);
    self.writer = new FramedSender<T>(self.input);
  }

  pub suspends send_blocking(T value): void {
    self.writer.send_blocking(value);
    return;
  }
  pub suspends complete_blocking(): void {
    self.writer.complete_blocking();
    return;
  }
  pub is_complete(): bool { return self.writer.is_complete(); }

  pub subscribe(): Subscription<T> {
    if !(try writech self.subscribed, true); then
      val Result<bool, String> failure = Err("only one subscriber is allowed");
      failure.expect("rx_channels.FramedPipe.subscribe");
    fi
    return new ChannelSubscription<T>(self.input);
  }
end

// Until generic return-context inference is available across imports, callers
// pass an explicitly typed None to bind T. Reject Some rather than consuming data.
pub fnc framed_pipe<T>(int capacity, Option<T> witness): FramedPipe<T> {
  if witness.is_some(); then
    val Result<bool, String> failure = Err("framed pipe witness must be None");
    failure.expect("rx_channels.framed_pipe");
  fi
  return new FramedPipe<T>(capacity);
}

pub fnc framed_sender<T>(Channel<Option<T>> output): FramedSender<T> {
  return new FramedSender<T>(output);
}

pub fnc send<T>(Channel<Option<T>> output, T value): Future<void> {
  return nb writech output, Some(value);
}

pub fnc complete<T>(Channel<Option<T>> output): Future<void> {
  val Option<T> terminal = None;
  return nb writech output, terminal;
}

define class MapSubscription<A, B> extends Subscription<B> as
  val Subscription<A> upstream;
  val Fnc<A, B> transform;

  constructor(Subscription<A> upstream, Fnc<A, B> transform) {
    self.upstream = upstream;
    self.transform = transform;
  }

  pub pull_result(): Result<Option<B>, Object> {
    val Result<Option<A>, Object> outcome = self.upstream.next_result();
    match outcome
      Ok(frame) -> {
        if frame.is_none(); then
          return Ok(None);
        fi
        try {
          return Ok(Some(self.transform(frame.unwrap())));
        } catch (err) {
          return Err(err);
        }
      }
      Err(err) -> {
        return Err(err);
      }
    end
  }

  pub pull(): Option<B> {
    return self.pull_result().expect("rx_channels.MapSubscription.pull");
  }

  pub dispose(): void {
    self.upstream.cancel();
    return;
  }
end

define class FilterSubscription<T> extends Subscription<T> as
  val Subscription<T> upstream;
  val Fnc<T, bool> predicate;

  constructor(Subscription<T> upstream, Fnc<T, bool> predicate) {
    self.upstream = upstream;
    self.predicate = predicate;
  }

  pub pull_result(): Result<Option<T>, Object> {
    loop {
      val Result<Option<T>, Object> outcome = self.upstream.next_result();
      match outcome
        Ok(frame) -> {
          if frame.is_none(); then
            return Ok(None);
          fi
          val T value = frame.unwrap();
          try {
            if self.predicate(value); then
              return Ok(Some(value));
            fi
          } catch (err) {
            return Err(err);
          }
        }
        Err(err) -> {
          return Err(err);
        }
      end
    }
  }

  pub pull(): Option<T> {
    return self.pull_result().expect("rx_channels.FilterSubscription.pull");
  }

  pub dispose(): void {
    self.upstream.cancel();
    return;
  }
end

define class TakeSubscription<T> extends Subscription<T> as
  val Subscription<T> upstream;
  val Channel<int> remaining = Channel.new<int>(1);

  constructor(Subscription<T> upstream, int count) {
    self.upstream = upstream;
    if count < 0; then
      val Result<bool, String> failure = Err("take count must be nonnegative");
      failure.expect("rx_channels.take");
    fi
    writech self.remaining, count;
  }

  pub pull_result(): Result<Option<T>, Object> {
    val int count = readch self.remaining;
    if count == 0; then
      writech self.remaining, 0;
      self.upstream.cancel();
      return Ok(None);
    fi
    writech self.remaining, count - 1;
    val Result<Option<T>, Object> outcome = self.upstream.next_result();
    match outcome
      Ok(frame) -> {
        if count == 1 || frame.is_none(); then
          self.upstream.cancel();
        fi
        return Ok(frame);
      }
      Err(err) -> {
        self.upstream.cancel();
        return Err(err);
      }
    end
  }

  pub pull(): Option<T> {
    return self.pull_result().expect("rx_channels.TakeSubscription.pull");
  }

  pub dispose(): void {
    self.upstream.cancel();
    return;
  }
end

define class MapObservable<A, B> extends Observable<B> as
  val Observable<A> source;
  val Fnc<A, B> transform;
  constructor(Observable<A> source, Fnc<A, B> transform) {
    self.source = source;
    self.transform = transform;
  }
  pub subscribe(): Subscription<B> {
    return new MapSubscription<A, B>(self.source.subscribe(), self.transform);
  }
end

define class FilterObservable<T> extends Observable<T> as
  val Observable<T> source;
  val Fnc<T, bool> predicate;
  constructor(Observable<T> source, Fnc<T, bool> predicate) {
    self.source = source;
    self.predicate = predicate;
  }
  pub subscribe(): Subscription<T> {
    return new FilterSubscription<T>(self.source.subscribe(), self.predicate);
  }
end

define class TakeObservable<T> extends Observable<T> as
  val Observable<T> source;
  val int count;
  constructor(Observable<T> source, int count) {
    self.source = source;
    self.count = count;
  }
  pub subscribe(): Subscription<T> {
    return new TakeSubscription<T>(self.source.subscribe(), self.count);
  }
end

pub fnc map<A, B>(Observable<A> source, Fnc<A, B> transform): Observable<B> {
  return new MapObservable<A, B>(source, transform);
}

pub fnc filter<T>(Observable<T> source, Fnc<T, bool> predicate): Observable<T> {
  return new FilterObservable<T>(source, predicate);
}

pub fnc take<T>(Observable<T> source, int count): Observable<T> {
  return new TakeObservable<T>(source, count);
}

define class MergeSubscription<T> extends Subscription<T> as
  val Channel<bool> stopped = Channel.new<bool>(1);
  val Channel<bool> left_done = Channel.new<bool>(1);
  val Channel<bool> right_done = Channel.new<bool>(1);
  val SelectSet both;
  val SelectSet left_only;
  val SelectSet right_only;

  constructor(Channel<Option<T>> left, Channel<Option<T>> right) {
    self.both = SelectSet.new([
      SelectCase.read(self.stopped), SelectCase.read(left), SelectCase.read(right)
    ]);
    self.left_only = SelectSet.new([SelectCase.read(self.stopped), SelectCase.read(left)]);
    self.right_only = SelectSet.new([SelectCase.read(self.stopped), SelectCase.read(right)]);
  }

  pub pull(): Option<T> {
    loop {
      val bool left_done = marked(self.left_done);
      val bool right_done = marked(self.right_done);
      if left_done && right_done; then
        return None;
      fi
      let SelectSet cases = self.both;
      if left_done; then
        cases = self.right_only;
      elif right_done; then
        cases = self.left_only;
      fi
      val Option<SelectResult> selected_option =
          await (nb select from cases);
      if selected_option.is_none(); then
        return None;
      fi
      val SelectResult selected = selected_option.unwrap();
      val int index = selected.index;
      if index == 0; then
        return None;
      fi
      val Option<T> frame = selected.value;
      if frame.is_some(); then
        return frame;
      fi
      if left_done; then
        try writech self.right_done, true;
      elif right_done || index == 1; then
        try writech self.left_done, true;
      else
        try writech self.right_done, true;
      fi
    }
  }

  pub dispose(): void {
    try writech self.stopped, true;
    return;
  }
end

define class MergeObservable<T> extends Observable<T> as
  val Channel<Option<T>> left;
  val Channel<Option<T>> right;
  val Channel<bool> subscribed = Channel.new<bool>(1);
  constructor(Channel<Option<T>> left, Channel<Option<T>> right) {
    self.left = left;
    self.right = right;
  }
  pub subscribe(): Subscription<T> {
    if !(try writech self.subscribed, true); then
      val Result<bool, String> failure = Err("only one subscriber is allowed");
      failure.expect("rx_channels.MergeObservable.subscribe");
    fi
    return new MergeSubscription<T>(self.left, self.right);
  }
end

// FAIR round-robin over reusable sets. Each input has one consumer and sends
// exactly one None after its final Some. Completed inputs leave the selection.
pub fnc merge_channels<T>(Channel<Option<T>> left, Channel<Option<T>> right): Observable<T> {
  return new MergeObservable<T>(left, right);
}

// Future producers keep their own lifetime. This subscription selects
// atomically between its private cancellation signal and the borrowed Future.
// A stop-channel win detaches the select's Future waiter without cancelling
// the producer Future; a Future failure remains Result.Err through pull_result.
define class FutureSubscription<T> extends Subscription<T> as
  val Future<T> pending;
  val Channel<bool> emitted = Channel.new<bool>(1);
  val Channel<bool> stopped = Channel.new<bool>(1);
  val SelectSet cases;

  constructor(Future<T> pending) {
    self.pending = pending;
    self.cases = SelectSet.new([
      SelectCase.read(self.stopped),
      SelectCase.future(pending)
    ]);
  }

  pub pull_result(): Result<Option<T>, Object> {
    if !(try writech self.emitted, true); then
      return Ok(None);
    fi
    try {
      val Option<SelectResult> selected_option =
          await (nb select first from self.cases);
      if selected_option.is_none(); then
        return Ok(None);
      fi
      val SelectResult selected = selected_option.unwrap();
      if selected.index == 0; then
        return Ok(None);
      fi
      val T value = selected.value;
      return Ok(Some(value));
    } catch (err) {
      return Err(err);
    }
  }

  pub pull(): Option<T> {
    return self.pull_result().expect("rx_channels.FutureSubscription.pull");
  }

  pub dispose(): void {
    // Selection cancellation is local to this subscription: the Future case
    // loses and detaches its waiter; the shared producer Future stays alive.
    try writech self.stopped, true;
    return;
  }
end

define class FutureObservable<T> extends Observable<T> as
  val Future<T> pending;
  constructor(Future<T> pending) { self.pending = pending; }
  pub subscribe(): Subscription<T> { return new FutureSubscription<T>(self.pending); }
end

pub fnc from_future<T>(Future<T> pending): Observable<T> {
  return new FutureObservable<T>(pending);
}

// Compatibility view: empty is None. Use first_required for a failed
// stream-style first() when no element exists.
pub fnc first_result<T>(Observable<T> source): Result<Option<T>, Object> {
  val Subscription<T> sub = source.subscribe();
  try {
    return sub.next_result();
  } catch (err) {
    return Err(err);
  } finally {
    sub.cancel();
  }
}

pub fnc first<T>(Observable<T> source): Option<T> {
  val Result<Option<T>, Object> outcome = first_result(source);
  return outcome.expect("rx_channels.first upstream failed");
}

pub fnc first_required<T>(Observable<T> source): T {
  val Option<T> value = first(source);
  if value.is_none(); then
    val Result<T, String> failure = Err("empty stream");
    return failure.expect("rx_channels.first_required");
  fi
  return value.unwrap();
}
